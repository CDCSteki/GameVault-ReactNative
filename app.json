{
  "expo": {
    "name": "GameVault",
    "slug": "gamevault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.gamevault",
      "infoPlist": {
        "NSCameraUsageDescription": "GameVault needs access to your camera to set a profile picture.",
        "NSPhotoLibraryUsageDescription": "GameVault needs access to your photo library to set a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.example.gamevault",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "GameVault needs access to your photos to set a profile picture.",
          "cameraPermission": "GameVault needs access to your camera to take a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "gamevault",
    "experiments": {
      "typedRoutes": true
    }
  }
}